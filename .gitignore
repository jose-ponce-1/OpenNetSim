# ====================================================================
# Android & Gradle Build Artifacts
# ====================================================================
*.apk
*.aar
*.ap_
*.aab

# Java archives & Libraries (preserving Gradle Wrapper)
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Dalvik / ART & Java class files
*.dex
*.class

# Generated build directories & caches
bin/
gen/
out/
build/
*/build/
.gradle/
.kotlin/
.kotlinc/

# Profiler & captures
captures/
.navigation/
*.hprof

# ====================================================================
# Local Configuration & Sensitive Files
# ====================================================================
# Android SDK location & local environment configuration
local.properties

# Signing credentials & keystores
*.jks
*.keystore
secrets.properties
signing.properties

# Google Services / Crashlytics / Firebase configuration
google-services.json

# Log files
*.log

# ====================================================================
# IDE & Editor Files
# ====================================================================
# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code
.vscode/

# ====================================================================
