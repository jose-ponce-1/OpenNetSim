<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono animado de la pantalla de carga (Android 12+), 1 s en total: el marco se dibuja (0–520 ms), aparece
  el nodo izquierdo (200 ms), la onda recorre el logo (240–800 ms) y aparece el nodo derecho (680 ms).
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_logo_animated">

    <target android:name="frame_top">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:startOffset="0"
                android:duration="520"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="frame_bottom">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:startOffset="0"
                android:duration="520"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="pulse">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:startOffset="240"
                android:duration="560"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="dot_left">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:startOffset="200"
                android:duration="320"
                android:interpolator="@android:interpolator/fast_out_slow_in">
                <propertyValuesHolder android:propertyName="scaleX">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.7" android:value="1.3" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.7" android:value="1.3" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
    <target android:name="dot_right">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:startOffset="680"
                android:duration="320"
                android:interpolator="@android:interpolator/fast_out_slow_in">
                <propertyValuesHolder android:propertyName="scaleX">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.7" android:value="1.3" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY">
                    <keyframe android:fraction="0" android:value="0" />
                    <keyframe android:fraction="0.7" android:value="1.3" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

</animated-vector>
