    <!-- About -->
    <string name="about_version">Version %1$s</string>
    <string name="about_description">Simulates slow, unstable or lossy networks on this very device. It captures traffic with Android’s VpnService and forwards it from the phone itself, with no external servers and no root.</string>
    <string name="about_open_source_title">Open source</string>
    <string name="about_open_source_text">OpenNetSim is open source under the Apache 2.0 license: you can use, study, modify and share it freely. It is provided as is, without warranty of any kind.</string>
