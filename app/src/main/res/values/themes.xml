<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema de la ventana tras la pantalla de carga; la interfaz la pinta Compose con OpenNetSimTheme. -->
    <style name="Theme.OpenNetSim" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Pantalla de carga (androidx.core:core-splashscreen): logo animado en API 31+, estático antes. -->
    <style name="Theme.OpenNetSim.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenNetSim</item>
    </style>

</resources>
